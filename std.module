<?php

use Drupal\node\Entity\NodeType;
use Drupal\Core\EntityInterface;
use Drupal\Core\Entity\EntityStorageException;
use Drupal\Core\Url;
use Drupal\views\Entity\View;
use Drupal\views\ViewExecutable;
use Drupal\views\Views;
use Drupal\views\ViewEntityInterface;

/**
 * Implements hook_theme
 */
function std_theme($existing, $type, $theme, $path)
{
    return [
        'list-page' => [
            'variables' => array(
                'items' => array(
                    'offset' => '',
                    'first' => '',
                    'last' => '',
                    'previous' => '',
                    'next' => '',
                    'links' => array(),
                    'title' => ''
                )
            )
        ],
        'study_review_queue' => [
            'variables' => [
                'studies' => [],
                'title' => '',
            ],
            'template' => 'study-review-queue',
        ],
    ];
}

/**
 * Implements hook_preprocess_HOOK() for block templates.
 */
function std_preprocess_block(&$variables) {
  // Add the rep/rep_js_css library.
  $attachments['#attached']['library'][] = 'rep/rep_js_css';
}

/**
 * Implements hook_menu_links_discovered_alter().
 */
function std_menu_links_discovered_alter(&$links) {

  //\Drupal::logger('std_notices')->notice('menu_links_discovered_alter function called.');

  $preferred_process = \Drupal::config('rep.settings')->get('preferred_process');

  if (isset($links['std.manage_workflow'])) {
    $links['std.manage_workflow']['title'] = 'Manage ' . $preferred_process;
    $links['std.manage_workflow']['weight'] = 22;
  }
  if (isset($links['std.manage_workflowstems'])) {
    $links['std.manage_workflowstems']['title'] = 'Manage ' . $preferred_process . ' Stems';
    $links['std.manage_workflowstems']['weight'] = 23;
  }
}

/**
 * Resolve manage-study ownership mode for the current route.
 */
function std_get_manage_study_mode(): ?string {
  if (\Drupal::routeMatch()->getRouteName() !== 'std.manage_study_elements') {
    return NULL;
  }

  $studyuriParam = \Drupal::routeMatch()->getParameter('studyuri');
  if (!is_string($studyuriParam) || trim($studyuriParam) === '') {
    return NULL;
  }

  $decodedStudyUri = base64_decode($studyuriParam, TRUE);
  if (!is_string($decodedStudyUri) || trim($decodedStudyUri) === '') {
    return NULL;
  }

  try {
    $api = \Drupal::service('rep.api_connector');
    $study = $api->parseObjectResponse($api->getUri($decodedStudyUri), 'getUri');
    if (!is_object($study)) {
      return NULL;
    }

    $piMbox = '';
    if (isset($study->pi) && is_object($study->pi)) {
      $piMbox = strtolower(trim((string) ($study->pi->mbox ?? '')));
    }

    $currentEmail = strtolower(trim((string) (\Drupal::currentUser()->getEmail() ?? '')));
    $ownerCandidates = [
      strtolower(trim((string) ($study->hasSIRManagerEmail ?? ''))),
      strtolower(trim((string) ($study->contactEmail ?? ''))),
      $piMbox,
    ];

    if (in_array($currentEmail, $ownerCandidates, TRUE) && $currentEmail !== '') {
      return 'edit';
    }

    return 'view';
  }
  catch (\Throwable $e) {
    return NULL;
  }
}

/**
 * Implements hook_preprocess_html().
 */
function std_preprocess_html(array &$variables) {
  $mode = std_get_manage_study_mode();
  if ($mode === NULL) {
    return;
  }

  $variables['attributes']['class'][] = 'std-manage-study-mode-' . $mode;
}

/**
 * Implements hook_preprocess_page().
 */
function std_preprocess_page(array &$variables) {
  $routeName = \Drupal::routeMatch()->getRouteName();
  if (!in_array($routeName, ['std.manage_study_elements', 'std.edit_study', 'std.edit_processbasedstudy'], TRUE)) {
    return;
  }
  $preferredStudy = trim((string) (\Drupal::config('rep.settings')->get('preferred_study') ?: 'Study'));
  $preferredStudyEscaped = \Drupal\Component\Utility\Html::escape($preferredStudy);
  $manageTitle = $preferredStudyEscaped . ' Search > Manage ' . $preferredStudyEscaped . ' Elements';

  if ($routeName === 'std.manage_study_elements') {
    $variables['title'] = \Drupal\Core\Render\Markup::create($manageTitle);
    return;
  }

  $variables['title'] = \Drupal\Core\Render\Markup::create(
    $manageTitle . ' > Edit ' . $preferredStudyEscaped
  );
}
